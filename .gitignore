# ── Node / extension ─────────────────────────────────────────────
node_modules/
extension/dist/
extension/build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vitest / coverage
coverage/
.vitest-cache/

# ── Python / server ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
server/venv/
server/.venv/
server/env/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ORT wasm binaries — copied from node_modules at build time, not committed
extension/public/ort/

# transformers.js's own onnxruntime-web wasm binaries — separate version from
# the above, staged at build time. See build.mjs.
extension/public/ort-tfjs/

# MeridianPII NER model — 55MB, over GitHub's 50MB warning (unlike the 10MB
# YOLO face model we commit directly). Staged manually for now; see
# README.md "Models" for source + sha256.
extension/public/models/plingampally/

# ── Model weights — large binaries, document the download in README ─
extension/assets/models/*.onnx
extension/assets/models/*.bin
extension/assets/models/*.safetensors
server/**/weights/
server/**/*.pt
server/**/*.gguf

# ── Env / secrets — never commit real values ─────────────────────
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini

# ── Editors ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────────
*.log
.tmp/
*.zip
.claude/
CLAUDE.md
graphify-out/
