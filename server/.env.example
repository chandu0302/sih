# Copy this file to .env and fill in your own key. .env is gitignored —
# never commit a real key.

# Get a free key at https://openrouter.ai/keys (email or GitHub, no card
# needed for the free tier).
OPENROUTER_API_KEY=

# Optional — defaults to a free vision-capable model if unset (see
# app/config.py's DEFAULT_MODEL). Set this once you're ready to use a paid
# model for better accuracy, e.g.:
# VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
VLM_MODEL=
